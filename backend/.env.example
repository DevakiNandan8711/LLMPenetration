# Copy to .env and adjust.

# --- Groq (default OpenAI-compatible endpoint; same as: curl https://api.groq.com/openai/v1/chat/completions) ---
LLM_PROVIDER=openai
GROQ_API_KEY=
# Optional: use OPENAI_API_KEY instead if you prefer one name for any compatible provider
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Or OpenAI (override base URL + model)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Or local Ollama (host): set LLM_PROVIDER=ollama and point to your instance
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# false = use Groq/LLM (requires GROQ_API_KEY). true = canned steps only (no API calls)
DEMO_MODE=false

# Execute shell commands in this image (build: docker build -t hacksynth-sandbox:latest ./sandbox)
SANDBOX_IMAGE=hacksynth-sandbox:latest

# If Docker CLI/socket is unavailable, executor returns mock output
USE_MOCK_EXECUTOR=false

COMMAND_TIMEOUT_SEC=120
DEFAULT_MAX_STEPS=24
